	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Get Cognito Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-amz-json-1.1"
							},
							{
								"key": "X-Amz-Target",
								"value": "AWSCognitoIdentityProviderService.InitiateAuth"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n  \"ClientId\": \"{{cognito_client_id}}\",\n  \"AuthParameters\": {\n    \"USERNAME\": \"{{cognito_username}}\",\n    \"PASSWORD\": \"{{cognito_password}}\"\n  }\n}"
						},
						"url": {
							"raw": "https://cognito-idp.{{aws_region}}.amazonaws.com/",
							"protocol": "https",
							"host": [
								"cognito-idp",
								"{{aws_region}}",
								"amazonaws",
								"com"
							]
						},
						"description": "Authenticate with Cognito using username and password. This will set the access_token, id_token, and refresh_token in the environment."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.AuthenticationResult) {",
									"        pm.environment.set(\"cognito_access_token\", jsonData.AuthenticationResult.AccessToken);",
									"        pm.environment.set(\"cognito_id_token\", jsonData.AuthenticationResult.IdToken);",
									"        pm.environment.set(\"cognito_refresh_token\", jsonData.AuthenticationResult.RefreshToken);",
									"    }",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "Refresh Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-amz-json-1.1"
							},
							{
								"key": "X-Amz-Target",
								"value": "AWSCognitoIdentityProviderService.InitiateAuth"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"AuthFlow\": \"REFRESH_TOKEN_AUTH\",\n  \"ClientId\": \"{{cognito_client_id}}\",\n  \"AuthParameters\": {\n    \"REFRESH_TOKEN\": \"{{cognito_refresh_token}}\"\n  }\n}"
						},
						"url": {
							"raw": "https://cognito-idp.{{aws_region}}.amazonaws.com/",
							"protocol": "https",
							"host": [
								"cognito-idp",
								"{{aws_region}}",
								"amazonaws",
								"com"
							]
						},
						"description": "Refresh the access token using the refresh token"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.AuthenticationResult) {",
									"        pm.environment.set(\"cognito_access_token\", jsonData.AuthenticationResult.AccessToken);",
									"        pm.environment.set(\"cognito_id_token\", jsonData.AuthenticationResult.IdToken);",
									"    }",
									"}"
								]
							}
						}
					]
				}
			]
		},
